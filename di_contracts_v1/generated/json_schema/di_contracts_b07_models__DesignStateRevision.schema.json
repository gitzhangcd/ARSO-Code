{
  "$defs": {
    "ActorId": {
      "title": "ActorId",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/ActorId"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "USER",
        "SERVICE",
        "AGENT",
        "SYSTEM",
        "EXTERNAL"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ContentHash": {
      "title": "ContentHash",
      "type": "string"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
