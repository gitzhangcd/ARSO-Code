    "JsonValue": {},
    "LogicalId": {
      "title": "LogicalId",
      "type": "string"
    },
    "ObjectId": {
      "title": "ObjectId",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "object_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "content_hash"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ObjectType": {
      "title": "ObjectType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "command_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_source_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "External Source Refs",
          "type": "array"
        },
        "run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_refs": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExactObjectRef"
              },
              {
                "$ref": "#/$defs/ObjectRef"
              }
            ]
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReviewStageProjection": {
      "enum": [
        "NOT_IN_REVIEW",
        "IN_REVIEW",
        "CHANGES_REQUESTED",
        "REJECTED",
        "APPROVED",
        "FINAL_APPROVED"
      ],
      "title": "ReviewStageProjection",
      "type": "string"
    },
    "SchemaVersion": {
      "title": "SchemaVersion",
      "type": "string"
    },
    "SemanticStage": {
      "enum": [
        "BRIEF",
        "CONTEXT_BOUND",
        "DECIDED",
        "ROUTES_AVAILABLE",
        "ROUTE_SELECTED",
        "SPECIFIED"
