    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "decision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
