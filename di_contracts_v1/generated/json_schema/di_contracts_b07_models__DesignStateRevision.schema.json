    "semantic_stage": {
      "$ref": "#/$defs/SemanticStage"
    },
    "spec_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tenant_scope": {
      "$ref": "#/$defs/TenantScope"
    },
    "transition_reason": {
      "title": "Transition Reason",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "object_type",
    "created_at",
    "created_by",
    "tenant_scope",
    "lineage_ref",
    "branch_ref",
    "brief_ref",
    "semantic_stage",
    "transition_reason"
  ],
  "title": "DesignStateRevision",
  "type": "object"
}