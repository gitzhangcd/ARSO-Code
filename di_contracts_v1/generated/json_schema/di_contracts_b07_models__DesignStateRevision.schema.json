        "logical_id": {
          "$ref": "#/$defs/LogicalId"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "version_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "required": [
        "object_type",
        "logical_id",
        "version_id",
        "content_hash"
      ],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "ExecutionStageProjection": {
      "enum": [
        "NOT_EXECUTED",
        "HAS_INSTANCE"
