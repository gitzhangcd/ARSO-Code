    "execution_stage": {
      "$ref": "#/$defs/ExecutionStageProjection",
      "default": "NOT_EXECUTED"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "id": {
      "$ref": "#/$defs/ObjectId"
    },
    "lineage_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "object_type": {
      "$ref": "#/$defs/ObjectType"
    },
    "parent_state_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Parent State Refs",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "review_stage_projection": {
      "$ref": "#/$defs/ReviewStageProjection",
      "default": "NOT_IN_REVIEW"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "selected_instance_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Selected Instance Refs",
      "type": "array"
