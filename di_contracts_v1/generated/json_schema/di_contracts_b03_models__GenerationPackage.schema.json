        "preference_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Preference Refs",
          "type": "array"
        },
        "preserve_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Preserve Refs",
          "type": "array"
        }
      },
      "title": "GenerationConstraintBundle",
      "type": "object"
