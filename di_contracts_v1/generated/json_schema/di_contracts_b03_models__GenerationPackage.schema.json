        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "content_hash"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ObjectType": {
      "title": "ObjectType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "command_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
