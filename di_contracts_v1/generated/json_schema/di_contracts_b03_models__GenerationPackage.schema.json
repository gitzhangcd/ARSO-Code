              {
                "$ref": "#/$defs/ObjectRef"
              }
            ]
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "SchemaVersion": {
      "title": "SchemaVersion",
      "type": "string"
    },
    "TenantId": {
      "title": "TenantId",
      "type": "string"
    },
    "TenantScope": {
      "additionalProperties": false,
      "properties": {
        "scope_type": {
          "$ref": "#/$defs/TenantScopeType"
        },
        "tenant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TenantId"
            },
            {
              "type": "null"
