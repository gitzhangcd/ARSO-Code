        "strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        },
        "usage_mode": {
          "title": "Usage Mode",
          "type": "string"
        }
      },
      "required": [
        "reference_asset_ref",
        "reference_intent_ref",
        "usage_mode"
      ],
      "title": "CompiledReferenceBinding",
      "type": "object"
    },
    "ContentHash": {
      "title": "ContentHash",
      "type": "string"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "logical_id": {
          "$ref": "#/$defs/LogicalId"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "version_id": {
          "$ref": "#/$defs/ObjectId"
