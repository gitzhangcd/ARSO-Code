  "required": [
    "schema_version",
    "id",
    "object_type",
    "created_at",
    "created_by",
    "tenant_scope",
    "design_spec_ref",
    "compiler_ref",
    "executor_binding_ref",
    "operation",
    "execution_purpose",
    "mapping_trace_ref"
