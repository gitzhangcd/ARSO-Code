  "additionalProperties": false,
  "properties": {
    "compiler_ref": {
      "$ref": "#/$defs/ExactObjectRef"
    },
    "constraints": {
      "$ref": "#/$defs/GenerationConstraintBundle"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
