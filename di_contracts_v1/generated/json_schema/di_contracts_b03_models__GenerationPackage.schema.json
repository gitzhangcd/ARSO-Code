    },
    "design_spec_ref": {
      "$ref": "#/$defs/ExactObjectRef"
    },
    "execution_purpose": {
      "$ref": "#/$defs/ExecutionPurpose"
    },
    "executor_binding_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "id": {
      "$ref": "#/$defs/ObjectId"
    },
    "mapping_trace_ref": {
      "$ref": "#/$defs/ObjectRef"
    },
    "object_type": {
      "$ref": "#/$defs/ObjectType"
    },
    "operation": {
      "$ref": "#/$defs/GenerationOperation"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reference_bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CompiledReferenceBinding"
      },
      "title": "Reference Bindings",
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "tenant_scope": {
      "$ref": "#/$defs/TenantScope"
    },
    "textual_payload": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Textual Payload"
    }
