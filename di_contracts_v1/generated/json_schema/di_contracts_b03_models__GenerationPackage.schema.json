    "JsonValue": {},
    "LogicalId": {
      "title": "LogicalId",
      "type": "string"
    },
    "ObjectId": {
      "title": "ObjectId",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
