{
  "$defs": {
    "ActorId": {
      "description": "Strict non-empty nominal identity for an attributed actor.",
      "minLength": 1,
      "title": "ActorId",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "description": "Exact two-part actor attribution reference.",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/ActorId"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "description": "Strict non-empty open vocabulary for actor attribution type.",
      "minLength": 1,
      "title": "ActorType",
      "type": "string"
    },
    "BriefRequirement": {
      "additionalProperties": false,
      "description": "One authored B01 brief constraint or preference.",
      "properties": {
        "dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dimension"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/RequirementStrength"
        }
      },
      "required": [
        "statement",
        "strength",
        "dimension"
      ],
      "title": "BriefRequirement",
      "type": "object"
    },
    "ContentHash": {
      "description": "Self-describing SHA-256 content hash wire value.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ContentHash",
      "type": "string"
    },
    "DesignSpecAssignment": {
      "additionalProperties": false,
      "description": "One semantic parameter assignment owned by a DesignSpec.",
      "properties": {
        "parameter_key": {
          "title": "Parameter Key",
          "type": "string"
        },
        "strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementStrength"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "parameter_key",
        "value",
        "strength"
      ],
      "title": "DesignSpecAssignment",
      "type": "object"
    },
    "ExactObjectRef": {
      "additionalProperties": false,
      "description": "Persistent exact reference for one canonical revision.",
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "logical_id": {
          "$ref": "#/$defs/LogicalId"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "version_id": {
          "$ref": "#/$defs/ObjectId"
        }
      },
      "required": [
        "object_type",
        "logical_id",
        "version_id",
        "content_hash"
      ],
      "title": "ExactObjectRef",
      "type": "object"
    },
    "JsonValue": {},
    "LogicalId": {
      "description": "Long-lived identity of one logical entity.",
      "title": "LogicalId",
      "type": "string"
    },
    "ObjectId": {
      "description": "Opaque identity of one exact immutable object/version.",
      "title": "ObjectId",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "Persistent reference for one non-versioned immutable object.",
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "object_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "content_hash"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ObjectRevision": {
      "description": "Server-assigned revision ordering metadata, never identity or parentage.",
      "minimum": 1,
      "title": "ObjectRevision",
      "type": "integer"
    },
    "ObjectType": {
      "description": "Nominal canonical object-type identity.",
      "title": "ObjectType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Immutable source basis using only persistent canonical references.",
      "properties": {
        "external_source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Source Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExactObjectRef"
              },
              {
                "$ref": "#/$defs/ObjectRef"
              }
            ]
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "source_refs",
        "external_source_refs"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RequirementStrength": {
      "description": "Frozen B01 requirement-strength wire vocabulary.",
      "enum": [
        "MUST",
        "PREFER",
        "EXPLORE",
        "AVOID",
        "FORBID"
      ],
      "title": "RequirementStrength",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Nominal schema-version identity.",
      "title": "SchemaVersion",
      "type": "string"
    },
    "TenantId": {
      "description": "Strict non-empty nominal tenant-isolation identity.",
      "minLength": 1,
      "title": "TenantId",
      "type": "string"
    },
    "TenantScope": {
      "additionalProperties": false,
      "description": "Infrastructure-level GLOBAL or single-TENANT isolation scope.",
      "properties": {
        "scope_type": {
          "$ref": "#/$defs/TenantScopeType"
        },
        "tenant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TenantId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope_type",
        "tenant_id"
      ],
      "title": "TenantScope",
      "type": "object"
    },
    "TenantScopeType": {
      "description": "Frozen tenant-isolation discriminator values.",
      "enum": [
        "GLOBAL",
        "TENANT"
      ],
      "title": "TenantScopeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "B01 semantic parameter assignment contract before compilation/execution.",
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/DesignSpecAssignment"
      },
      "minItems": 1,
      "title": "Assignments",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/BriefRequirement"
      },
      "title": "Constraints",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "id": {
      "$ref": "#/$defs/ObjectId"
    },
    "logical_id": {
      "$ref": "#/$defs/LogicalId"
    },
    "object_type": {
      "$ref": "#/$defs/ObjectType",
      "const": "di.b01.design_spec"
    },
    "parent_refs": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "title": "Parent Refs",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reference_intent_refs": {
      "items": {
        "$ref": "#/$defs/ExactObjectRef"
      },
      "title": "Reference Intent Refs",
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/ObjectRevision"
    },
    "route_ref": {
      "$ref": "#/$defs/ExactObjectRef"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "semantic_parameter_space_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactObjectRef"
        },
        {
          "$ref": "#/$defs/ObjectRef"
        }
      ],
      "title": "Semantic Parameter Space Ref"
    },
    "tenant_scope": {
      "$ref": "#/$defs/TenantScope"
    }
  },
  "required": [
    "schema_version",
    "id",
    "object_type",
    "created_at",
    "created_by",
    "tenant_scope",
    "provenance",
    "extensions",
    "logical_id",
    "revision",
    "parent_refs",
    "route_ref",
    "semantic_parameter_space_ref",
    "assignments",
    "reference_intent_refs",
    "constraints"
  ],
  "title": "DesignSpec",
  "type": "object"
}
